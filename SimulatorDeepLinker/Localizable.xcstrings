    "Enter a simulator UDID or choose Booted simulator." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Укажите UDID симулятора или выберите запущенный симулятор." } }
      }
    },
    "For example: https://example.com/product/123 or myapp://product/123" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Например: https://example.com/product/123 или myapp://product/123" } }
