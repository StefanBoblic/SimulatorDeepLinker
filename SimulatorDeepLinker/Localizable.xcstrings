  "strings": {
    "%@ exited with code %d. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ exited with code %2$d. %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ завершился с кодом %d. %@"
          }
        }
      }
    },
    "%@ was not found. Check the developer tools installation.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не найден. Проверьте установку инструментов разработчика."
          }
        }
      }
    },
    "%@ • %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
