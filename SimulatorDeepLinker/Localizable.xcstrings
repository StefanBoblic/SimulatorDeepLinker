{
  "sourceLanguage" : "en",
  "strings" : {
    "Booted simulator" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Запущенный симулятор" } }
      }
    },
    "Booted simulator is enough for the usual workflow: start the iPhone Simulator you need, then click Open." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Для обычного сценария достаточно запущенного симулятора: сначала запустите нужный iPhone Simulator, затем нажмите «Открыть»." } }
      }
    },
    "Changes saved" : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Изменения сохранены" } }
      }
    },
    "Check that Xcode is installed and a simulator is running." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Убедитесь, что Xcode установлен и симулятор запущен." } }
      }
    },
