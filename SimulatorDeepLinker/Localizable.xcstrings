          "stringUnit" : {
            "state" : "translated",
            "value" : "Теги"
          }
        }
      }
    },
    "A link can have multiple comma-separated tags. Tags are included in search and work best for platforms, test suites, or temporary labels." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У диплинка может быть несколько тегов, разделённых запятыми. Теги участвуют в поиске и подходят для платформ, наборов тестов и временных меток."
          }
        }
      }
    },
    "Examples: ios, android, smoke, regression" : {
