      }
    },
    "Invalid URL. Check the scheme, for example https://, myapp://, or magnit://." : {
      "localizations" : {
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Некорректный URL. Проверьте схему, например https://, myapp:// или magnit://." } }
